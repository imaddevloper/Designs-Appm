<?xml version="1.0" encoding="utf-8"?>
<!--
  accessibility_service_config.xml — إعدادات خدمة إمكانية الوصول.

  المسار الصحيح: app/src/main/res/xml/accessibility_service_config.xml

  هذا الملف هو "عقد" بين AccessibilityHelper والنظام.
  بدونه، الخدمة لا تعمل.

  يُشار إليه من AndroidManifest.xml عبر:
    <meta-data android:name="android.accessibilityservice"
               android:resource="@xml/accessibility_service_config" />

  الخصائص الأساسية:
  - accessibilityEventTypes: أنواع الأحداث التي نستقبلها.
  - accessibilityFeedbackType: نوع التغذية الراجعة (صوتي/لمسي/بصري).
  - canPerformGestures: ضروري لـ dispatchGesture (النقر/السحب).
  - canRetrieveWindowContent: ضروري لقراءة شجرة الشاشة.
  - notificationTimeout: تأخير استقبال الأحداث (ms).
  - accessibilityFlags: خيارات إضافية.

  ملاحظة: هذه الإعدادات تظهر للمستخدم في شاشة تفعيل الخدمة.
  كلما كانت أقل "خطورة" في الظاهر، كان التمويه أفضل.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_description"
    android:summary="@string/accessibility_summary"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canRequestTouchExplorationMode="false"
    android:canRequestFilterKeyEvents="false"
    android:canControlMagnification="false"
    android:canRequestEnhancedWebAccessibility="false"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagIncludeNotImportantViews"
    android:packageNames=""
    android:settingsActivity="" />
