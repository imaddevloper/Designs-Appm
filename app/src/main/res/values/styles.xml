<?xml version="1.0" encoding="utf-8"?>
<!--
  styles.xml — أنماط أزرار الآلة الحاسبة.

  المسار: app/src/main/res/values/styles.xml

  الأنماط:
  - CalcButton: النمط الأساسي (كل الأزرار ترث منه).
  - CalcButton.Number: أزرار الأرقام (خلفية داكنة).
  - CalcButton.Operator: أزرار العمليات (برتقالي).
  - CalcButton.Function: أزرار الوظائف مثل C و % (رمادي فاتح).

  ملاحظة: الألوان مستخدمة مباشرة هنا (وليس في colors.xml) لتبسيط الملف.
  إذا أردت، يمكنك نقلها إلى colors.xml لاحقاً.
-->
<resources>

    <!-- ============ النمط الأساسي لكل الأزرار ============ -->
    <style name="CalcButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/calc_button_bg</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- ============ أزرار الأرقام (رمادي داكن) ============ -->
    <style name="CalcButton.Number" parent="CalcButton">
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- ============ أزرار العمليات (برتقالي) ============ -->
    <style name="CalcButton.Operator" parent="CalcButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/calc_button_operator_bg</item>
        <item name="android:textSize">30sp</item>
    </style>

    <!-- ============ أزرار الوظائف (رمادي فاتح) ============ -->
    <style name="CalcButton.Function" parent="CalcButton">
        <item name="android:textColor">#1C1C1E</item>
        <item name="android:background">@drawable/calc_button_function_bg</item>
    </style>

</resources>