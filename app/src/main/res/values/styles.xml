<?xml version="1.0" encoding="utf-8"?>
<!--
  styles.xml — أنماط التصميم العامة (CyberSolve AI).
  
  المسار: app/src/main/res/values/styles.xml
-->
<resources>

    <!-- النمط الأساسي للنصوص الوصفية -->
    <style name="ScannerText">
        <item name="android:textColor">#A0A0A0</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- النمط الأساسي للنصوص المميزة -->
    <style name="ScannerTextTitle">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- نمط زر المسح الضوئي (إذا أردت إضافته لاحقاً) -->
    <style name="ScannerButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#000000</item>
        <item name="backgroundTint">#00E5FF</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
