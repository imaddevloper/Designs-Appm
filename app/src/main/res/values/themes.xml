<?xml version="1.0" encoding="utf-8"?>
<!--
  themes.xml — ثيم التطبيق (CyberSolve AI).
  
  التحديثات:
  - تغيير اللون الأساسي إلى الأسود الداكن (#121212).
  - تغيير لون التمييز إلى السماوي (#00E5FF) ليتناسب مع واجهة الماسح الضوئي.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ الثيم الأساسي للتطبيق ============ -->
    <style name="Theme.DisguiseApp" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- اللون الأساسي -->
        <item name="colorPrimary">#121212</item>

        <!-- اللون الأساسي الداكن -->
        <item name="colorPrimaryDark">#000000</item>

        <!-- لون التمييز (السماوي) -->
        <item name="colorAccent">#00E5FF</item>

        <!-- لون خلفية النافذة -->
        <item name="android:windowBackground">#121212</item>

        <!-- لون شريط الحالة -->
        <item name="android:statusBarColor">#121212</item>

        <!-- لون شريط التنقل -->
        <item name="android:navigationBarColor">#121212</item>

        <!-- إخفاء ActionBar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- إعدادات إضافية للتوافق -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

</resources>
